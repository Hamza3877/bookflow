# Copy this file to .env and fill it in.
NODE_ENV=development
PORT=5000

# Local MongoDB, or your free MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/bookflow

# Any long random text (16+ characters). Use different values for each.
JWT_ACCESS_SECRET=replace-with-a-long-random-text-1
JWT_REFRESH_SECRET=replace-with-a-long-random-text-2

# Address of the React app (used for CORS and Stripe redirects)
CLIENT_URL=http://localhost:5173

# Set to true ONLY if the website and API are on different domains
CROSS_SITE_COOKIES=false

# Optional: Stripe test mode. Leave empty to use the built-in test payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: Google Gemini (free key from aistudio.google.com). Empty = rule-based search.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
